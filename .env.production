# Build-time config for the deployed site (`vite build` loads this; `.env`
# still wins locally for dev). The broker pubkey is public, so it is committed:
# CI then builds without a secret, and a missing key can never ship a bundle
# that throws on load.
VITE_REGBY_MIDDLEMAN_PUBKEY=8ffc667ecf271b3eeff362a101600b10399e4d606907437edc3453d17d68788f
